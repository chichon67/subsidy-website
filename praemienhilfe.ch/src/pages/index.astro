---
// src/pages/index.astro
// Root `/` is no longer the homepage — the locale-aware homepage lives at
// src/pages/[lang]/index.astro. This page is a lightweight client-side
// language detector that redirects to /de/, /en/, or /es/.
//
// Storage key: `praemienhilfe_lang` — shared with LanguageSwitcher.astro,
// which writes a manually-picked locale here so it's remembered on the
// next visit to the root domain.
export const prerender = true;
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://praemien-hilfe.ch/de/" />
    <title>praemien-hilfe.ch</title>
    <script is:inline>
      (function () {
        var SUPPORTED = ['de', 'en', 'es'];
        try {
          var stored = localStorage.getItem('praemienhilfe_lang');
          var lang = SUPPORTED.includes(stored) ? stored : null;
          if (!lang) {
            var nav = ((navigator.language || 'de').slice(0, 2)).toLowerCase();
            lang = SUPPORTED.includes(nav) ? nav : 'de';
          }
          location.replace('/' + lang + '/' + location.search + location.hash);
        } catch (e) {
          location.replace('/de/');
        }
      })();
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=/de/" /></noscript>
  </head>
  <body></body>
</html>
