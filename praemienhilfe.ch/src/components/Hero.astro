---
// src/components/Hero.astro
import { Image } from 'astro:assets';
import Funnel from './Funnel.jsx';
import SituationFunnel from './SituationFunnel.jsx';
import SituationSelector from './SituationSelector.astro';
import heroPhoto from '../assets/hero-photo.jpg';
import swissVillage from '../assets/swiss-village-lake.jpg';
import { getNational } from '../data/national.js';
import { getDictionary, t } from '../i18n/index.js';

export interface Props {
  lang: string;
  canton?: { name: string; heroProof: string };
  defaultCanton?: string;
  useSituationFunnel?: boolean;
  variant?: 'canton' | 'national';
  embeddedFunnel?: boolean;
}
const { lang, canton, defaultCanton, useSituationFunnel = true, variant = 'canton', embeddedFunnel = false } = Astro.props;
const { heroCopy } = getNational(lang);
const dict = getDictionary(lang);
const isNational = variant === 'national';
const cantonHeading = canton?.name
  ? t(dict, 'hero.cantonHeading', { canton: canton.name })
  : t(dict, 'hero.cantonHeadingDefault');
const cantonParagraph = t(dict, 'hero.cantonParagraph');
---

<section id="pruefen" class="relative bg-white overflow-hidden">
  {isNational && (
    <>
      <div class="hidden md:block absolute inset-y-0 right-0 w-[46%] min-w-[420px] rounded-l-[50%] overflow-hidden">
        <Image
          src={swissVillage}
          alt={t(dict, 'hero.altVillage')}
          width={1200}
          height={1300}
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
      <div class="hidden md:flex absolute right-[10%] bottom-14 z-10 items-start gap-2.5 bg-white border border-[#E2E8EA] rounded-lg shadow-[0_4px_16px_rgba(26,26,42,0.1)] px-[17px] py-3.5 max-w-[300px]">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#3D8B37" stroke-width="2.4" stroke-linecap="round" class="flex-shrink-0 mt-0.5" aria-hidden="true">
          <path d="M4 13l5 5L20 7"></path>
        </svg>
        <div class="text-[13.5px] leading-snug text-dark">{heroCopy.proof}</div>
      </div>
    </>
  )}

  <div class={`relative max-w-[1240px] mx-auto px-8 pt-[58px] pb-[72px] ${isNational ? 'md:min-h-[580px] md:flex md:items-center' : ''}`}>
    {isNational ? (
      <div class="w-full md:max-w-[50%]">
        <h1 class="text-[32px] md:text-[48px] leading-[1.08] font-bold tracking-tight m-0">{heroCopy.title}</h1>
        <p class="text-base leading-[1.68] text-[#3D4A50] mt-5 max-w-[34em]">{heroCopy.paragraph}</p>
        <SituationSelector lang={lang} />
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-[55fr_45fr] gap-14 items-start">
        <div>
          <h1 class="text-[32px] md:text-[48px] leading-[1.08] font-bold tracking-tight m-0">
            {cantonHeading}
          </h1>
          <p class="text-base leading-[1.68] text-[#3D4A50] mt-5 max-w-[34em]">
            {cantonParagraph}
          </p>

          {embeddedFunnel ? <SituationFunnel client:load canton={defaultCanton} /> : useSituationFunnel ? <SituationSelector lang={lang} /> : <Funnel client:load defaultCanton={defaultCanton} />}
        </div>

        <div class="hidden md:block relative pt-1.5">
          <svg viewBox="0 0 600 600" class="absolute -top-6 -left-11 w-[122%] h-auto" aria-hidden="true">
            <path d="M20 470 A 340 340 0 0 1 470 40" fill="none" stroke="#0087A0" stroke-width="1.3" opacity="0.4"></path>
            <path d="M74 560 A 330 330 0 0 1 560 120" fill="none" stroke="#E8F4F8" stroke-width="26"></path>
          </svg>
          <div class="relative w-full max-w-[470px] ml-auto aspect-square rounded-full overflow-hidden">
            <Image
              src={heroPhoto}
              alt={t(dict, 'hero.altFamily')}
              width={940}
              height={940}
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
          <div class="relative -mt-[52px] -ml-2.5 inline-flex items-start gap-2.5 bg-white border border-[#E2E8EA] rounded-lg shadow-[0_4px_16px_rgba(26,26,42,0.1)] px-[17px] py-3.5 max-w-[330px]">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#3D8B37" stroke-width="2.4" stroke-linecap="round" class="flex-shrink-0 mt-0.5" aria-hidden="true">
              <path d="M4 13l5 5L20 7"></path>
            </svg>
            <div class="text-[13.5px] leading-snug text-dark">{canton?.heroProof}</div>
          </div>
        </div>
      </div>
    )}
  </div>
</section>
