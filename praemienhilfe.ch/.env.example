HUBSPOT_ACCESS_TOKEN=
PUBLIC_GA4_ID=
# Twenty CRM lead intake (netlify/functions/lead-to-twenty.ts) — server-side only, never PUBLIC_
# Set TWENTY_API_URL in Netlify. TWENTY_URL is still read when TWENTY_API_URL is empty.
TWENTY_API_URL=https://crm.evo-partners.ch
TWENTY_URL=
TWENTY_API_KEY=
TWENTY_ASSIGNEE_ID=85c3b03e-b96b-42cc-b140-b97a82765cb2
# Optional. Overrides one source token. Never set a value of IMPORTED.
# LEAD_SOURCE_MAP={"chatgpt.com":"EVENT"}
# Optional Person field API names. Defaults match the Person fields already in Twenty.
# consentGiven is BOOLEAN. consentAt is DATE_TIME (ISO 8601).
TWENTY_FIELD_LEAD_SOURCE=leadSource
TWENTY_FIELD_UTM_SOURCE=utmSource
TWENTY_FIELD_UTM_MEDIUM=utmMedium
TWENTY_FIELD_UTM_CAMPAIGN=utmCampaign
TWENTY_FIELD_UTM_TERM=utmTerm
TWENTY_FIELD_UTM_CONTENT=utmContent
TWENTY_FIELD_REFERRER=referrer
TWENTY_FIELD_LANDING_PAGE=landingPage
TWENTY_FIELD_CONSENT_GIVEN=consentGiven
TWENTY_FIELD_CONSENT_AT=consentAt
