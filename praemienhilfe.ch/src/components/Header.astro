---
// src/components/Header.astro
import { deutschschweizCantons } from '../data/deutschschweiz.js';
import { useTranslations } from '../i18n/useTranslations.js';

export interface Props {
  activePage?: 'home' | 'basel-stadt' | 'basel-landschaft' | 'canton' | 'ablauf' | 'faq' | 'kontakt' | 'legal';
  locale: 'de' | 'en' | 'es';
}
const { activePage = 'home', locale } = Astro.props;
const t = useTranslations(locale);
const isCantonLanding = activePage === 'basel-stadt' || activePage === 'basel-landschaft' || activePage === 'canton';
// All canton-landing pages render the same embedded SituationFunnel (id="funnel").
const cantonFunnelHref = '#funnel';
const showWerWirSind = activePage === 'basel-stadt' || activePage === 'canton';
// The homepage renders its own #so-funktioniert-es / #faq / #pruefen sections
// and links to those in-page; every other non-canton-landing page (dedicated
// /so-funktioniert-es, /faq, /kontakt) falls back to the homepage's copy.
const pruefenHref = activePage === 'home' ? '#pruefen' : `/${locale}/#pruefen`;
const sectionHref = (id: string) => (activePage === 'home' ? `#${id}` : `/${locale}/#${id}`);

const navLink = (key: string) =>
  activePage === key
    ? 'text-dark border-b-2 border-teal pb-1'
    : 'text-dark hover:text-teal pb-1 border-b-2 border-transparent';
---

<header class="fixed top-0 w-full z-50 bg-white border-b-2 border-teal transition-transform duration-300 translate-y-0">
  <div class="max-w-[1240px] mx-auto px-8 py-3.5 flex items-center justify-between gap-8">
    <a
      href={`/${locale}/`}
      class="flex items-center gap-3 no-underline"
      {...isCantonLanding ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
    >
      <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
        <rect x="2" y="2" width="24" height="24" rx="6" fill="#0087A0"></rect>
        <rect x="14" y="14" width="24" height="24" rx="6" fill="#F0A500"></rect>
        <rect x="14" y="14" width="12" height="12" fill="#005F73"></rect>
      </svg>
      <span class="block leading-tight">
        <span class="block text-[19px] font-bold text-dark tracking-tight">prämienhilfe</span>
        <span class="block text-[15px] font-medium text-teal tracking-wide">.ch</span>
      </span>
    </a>

    {isCantonLanding ? (
      <nav class="hidden [@media(min-width:980px)]:flex items-center gap-6 text-[14.5px] font-medium">
        <a href="#so-funktioniert-es" class="text-dark hover:text-teal pb-1 border-b-2 border-transparent">{t('nav.howItWorks')}</a>
        <a href="#faq" class="text-dark hover:text-teal pb-1 border-b-2 border-transparent">{t('nav.faq')}</a>
        {showWerWirSind && <a href="#wer-wir-sind" class="text-dark hover:text-teal pb-1 border-b-2 border-transparent">{t('footer.info.about')}</a>}
        <a href={cantonFunnelHref} class="px-4 py-2.5 bg-teal text-white rounded font-semibold hover:bg-teal-dark hover:text-white no-underline">{t('nav.cta.checkClaim')}</a>
        <div class="flex items-center gap-2.5 text-[13px] font-semibold text-[#8A979C] ml-1">
          {['de', 'en', 'es'].map((l) => (
            <a
              href={`/${l}/`}
              data-lang-switch={l}
              class={l === locale ? 'text-teal underline underline-offset-2' : 'hover:text-teal'}
              aria-current={l === locale ? 'true' : undefined}
            >
              {l.toUpperCase()}
            </a>
          ))}
        </div>
      </nav>
    ) : (
      <nav class="hidden [@media(min-width:980px)]:flex items-center gap-6 text-[14.5px] font-medium">
        <a href={`/${locale}/`} class={navLink('home')}>{t('nav.home')}</a>

        <div class="relative">
          <button
            type="button"
            id="kantone-menu-trigger"
            aria-expanded="false"
            aria-controls="kantone-menu-panel"
            class="flex items-center gap-1.5 bg-transparent border-0 p-0 cursor-pointer text-[14.5px] font-medium text-dark hover:text-teal"
          >
            <span>{t('nav.cantons')}</span>
            <span id="kantone-menu-caret" class="text-[11px] text-teal transition-transform duration-150">▾</span>
          </button>
          <div
            id="kantone-menu-panel"
            class="hidden fixed inset-x-0 top-[var(--header-h)] bg-white border-t border-[#E2E8EA] shadow-[0_16px_32px_rgba(26,26,42,0.12)]"
          >
            <div class="max-w-[1240px] mx-auto px-8 py-8">
              <h3 class="text-[12px] font-semibold uppercase tracking-wide text-[#6B7780] m-0 mb-4">{t('nav.cantons.subheading')}</h3>
              <div class="grid grid-cols-4 gap-3">
                {
                  deutschschweizCantons.map((c) => (
                    <a
                      href={`/${locale}/${c.slug}`}
                      onclick={`if (window.gtag) window.gtag('event', 'header_canton_menu_selected', { canton: '${c.slug}' })`}
                      class="flex items-center gap-3 bg-white border border-[#E2E8EA] rounded-[10px] px-4 py-3 no-underline transition-colors hover:border-teal hover:bg-teal-light"
                    >
                      <img src={c.wappen} alt="" width="26" height="26" class="flex-shrink-0" loading="lazy" />
                      <span class="text-[14px] font-medium text-dark leading-tight">{c.name}</span>
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        <a href={sectionHref('so-funktioniert-es')} class={navLink('ablauf')}>{t('nav.howItWorks')}</a>
        <a href={sectionHref('faq')} class={navLink('faq')}>{t('nav.faq')}</a>
        <a href={`/${locale}/kontakt`} class={navLink('kontakt')}>{t('nav.contact')}</a>
        <a href={pruefenHref} class="px-4 py-2.5 bg-teal text-white rounded font-semibold hover:bg-teal-dark hover:text-white no-underline">{t('nav.cta')}</a>

        <div class="flex items-center gap-2.5 text-[13px] font-semibold text-[#8A979C] ml-1">
          {['de', 'en', 'es'].map((l) => (
            <a
              href={`/${l}/`}
              data-lang-switch={l}
              class={l === locale ? 'text-teal underline underline-offset-2' : 'hover:text-teal'}
              aria-current={l === locale ? 'true' : undefined}
            >
              {l.toUpperCase()}
            </a>
          ))}
        </div>
      </nav>
    )}

    <label
      for="mobile-menu-toggle"
      class="[@media(min-width:980px)]:hidden flex items-center justify-center w-[42px] h-[42px] bg-white border border-[#D6DFE2] rounded cursor-pointer"
      aria-label={t('nav.menu.open')}
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1A1A2A" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h16"></path>
      </svg>
    </label>
  </div>
</header>

<input type="checkbox" id="mobile-menu-toggle" class="hidden peer" />
<div class="fixed inset-0 z-[60] bg-white overflow-y-auto hidden peer-checked:block">
  <div class="flex items-center justify-between px-6 py-[18px] border-b border-[#E2E8EA]">
    <div class="flex items-center gap-[11px]">
      <svg width="34" height="34" viewBox="0 0 40 40" aria-hidden="true">
        <rect x="2" y="2" width="24" height="24" rx="6" fill="#0087A0"></rect>
        <rect x="14" y="14" width="24" height="24" rx="6" fill="#F0A500"></rect>
        <rect x="14" y="14" width="12" height="12" fill="#005F73"></rect>
      </svg>
      <span class="text-[17px] font-bold">prämienhilfe<span class="text-teal">.ch</span></span>
    </div>
    <label for="mobile-menu-toggle" class="w-10 h-10 flex items-center justify-center border border-[#D6DFE2] rounded cursor-pointer text-xl text-dark" aria-label={t('nav.menu.close')}>×</label>
  </div>
  {isCantonLanding ? (
    <div class="px-6 py-7 grid gap-1">
      <a href="#so-funktioniert-es" class="py-3.5 px-0.5 text-[19px] font-semibold text-dark border-b border-[#EEF2F3] hover:text-teal no-underline">{t('nav.howItWorks')}</a>
      <a href="#faq" class="py-3.5 px-0.5 text-[19px] font-semibold text-dark border-b border-[#EEF2F3] hover:text-teal no-underline">{t('nav.faq')}</a>
      {showWerWirSind && <a href="#wer-wir-sind" class="py-3.5 px-0.5 text-[19px] font-semibold text-dark border-b border-[#EEF2F3] hover:text-teal no-underline">{t('footer.info.about')}</a>}
      <a href={cantonFunnelHref} class="mt-[18px] text-center py-4 bg-teal text-white rounded-md text-[16.5px] font-bold no-underline">{t('nav.cta.checkClaim')}</a>
      <div class="flex items-center justify-center gap-4 text-[14px] font-semibold text-[#8A979C] mt-5">
        {['de', 'en', 'es'].map((l) => (
          <a
            href={`/${l}/`}
            data-lang-switch={l}
            class={l === locale ? 'text-teal underline underline-offset-2' : 'hover:text-teal'}
            aria-current={l === locale ? 'true' : undefined}
          >
            {l.toUpperCase()}
          </a>
        ))}
      </div>
    </div>
  ) : (
    <div class="px-6 py-7 grid gap-1">
      <a href={`/${locale}/`} class="py-3.5 px-0.5 text-[19px] font-semibold text-dark border-b border-[#EEF2F3] hover:text-teal no-underline">{t('nav.home')}</a>
      <a href={`/${locale}/#kantone-grid`} class="py-3.5 px-0.5 text-[19px] font-semibold text-dark border-b border-[#EEF2F3] hover:text-teal no-underline">{t('nav.allCantons')}</a>
      <a href={`/${locale}/so-funktioniert-es`} class="py-3.5 px-0.5 text-[19px] font-semibold text-dark border-b border-[#EEF2F3] hover:text-teal no-underline">{t('nav.howItWorks')}</a>
      <a href={`/${locale}/faq`} class="py-3.5 px-0.5 text-[19px] font-semibold text-dark border-b border-[#EEF2F3] hover:text-teal no-underline">{t('nav.faq')}</a>
      <a href={`/${locale}/kontakt`} class="py-3.5 px-0.5 text-[19px] font-semibold text-dark border-b border-[#EEF2F3] hover:text-teal no-underline">{t('nav.contact')}</a>
      <a href={pruefenHref} class="mt-[18px] text-center py-4 bg-teal text-white rounded-md text-[16.5px] font-bold no-underline">{t('mobileCta.button')}</a>
      <div class="flex items-center justify-center gap-4 text-[14px] font-semibold text-[#8A979C] mt-5">
        {['de', 'en', 'es'].map((l) => (
          <a
            href={`/${l}/`}
            data-lang-switch={l}
            class={l === locale ? 'text-teal underline underline-offset-2' : 'hover:text-teal'}
            aria-current={l === locale ? 'true' : undefined}
          >
            {l.toUpperCase()}
          </a>
        ))}
      </div>
    </div>
  )}
</div>

<script>
  function initHeader() {
    const header = document.querySelector('header');
    if (!header) return;

    function setHeaderHeightVar() {
      document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
    }
    setHeaderHeightVar();
    window.addEventListener('resize', setHeaderHeightVar);

    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    if (mobileMenuToggle instanceof HTMLInputElement) {
      document.querySelectorAll('#mobile-menu-toggle ~ div a').forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenuToggle.checked = false;
        });
      });
    }

    let lastScrollY = window.scrollY;
    window.addEventListener(
      'scroll',
      () => {
        const currentScrollY = window.scrollY;
        if (currentScrollY < 10) {
          header.classList.remove('-translate-y-full');
          header.classList.add('translate-y-0');
        } else if (currentScrollY > lastScrollY) {
          header.classList.add('-translate-y-full');
          header.classList.remove('translate-y-0');
        } else {
          header.classList.remove('-translate-y-full');
          header.classList.add('translate-y-0');
        }
        lastScrollY = currentScrollY;
      },
      { passive: true }
    );
  }

  function initKantoneMenu() {
    const trigger = document.getElementById('kantone-menu-trigger');
    const panel = document.getElementById('kantone-menu-panel');
    const caret = document.getElementById('kantone-menu-caret');
    if (!trigger || !panel || !caret) return;

    // Trigger and panel are separated by the header's own padding, so a
    // straight mouse move from one to the other briefly crosses space that
    // belongs to neither element. A short close delay bridges that gap
    // instead of hiding the panel mid-transit (which made it impossible to
    // ever reach a canton link).
    let closeTimer: ReturnType<typeof setTimeout> | null = null;

    function open() {
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
      panel.classList.remove('hidden');
      trigger.setAttribute('aria-expanded', 'true');
      caret.classList.add('rotate-180');
    }

    function scheduleClose() {
      closeTimer = setTimeout(() => {
        panel.classList.add('hidden');
        trigger.setAttribute('aria-expanded', 'false');
        caret.classList.remove('rotate-180');
      }, 250);
    }

    trigger.addEventListener('mouseenter', open);
    trigger.addEventListener('mouseleave', scheduleClose);
    panel.addEventListener('mouseenter', open);
    panel.addEventListener('mouseleave', scheduleClose);
    trigger.addEventListener('focus', open);
    panel.addEventListener('focusout', (e) => {
      const next = (e as FocusEvent).relatedTarget;
      if (next instanceof Node && (panel.contains(next) || next === trigger)) return;
      scheduleClose();
    });
  }

  function initLangSwitcher() {
    document.querySelectorAll('[data-lang-switch]').forEach((link) => {
      link.addEventListener('click', (e) => {
        const target = link.getAttribute('data-lang-switch');
        document.cookie = `pv_lang=${target}; path=/; max-age=31536000; SameSite=Lax`;
        const current = window.location.pathname;
        const rest = current.replace(/^\/(de|en|es)(\/|$)/, '/');
        const candidate = `/${target}${rest === '/' ? '/' : rest}`;
        e.preventDefault();
        // Fall back to that locale's homepage if the equivalent path 404s under
        // Astro's DE-fallback (fallback only covers whole-route rewrites for
        // canton pages already known to Astro's routing table, not arbitrary
        // guesses) — a HEAD check keeps this simple and correct either way.
        fetch(candidate, { method: 'HEAD' })
          .then((res) => {
            window.location.href = res.ok ? candidate : `/${target}/`;
          })
          .catch(() => {
            window.location.href = `/${target}/`;
          });
      });
    });
  }

  initHeader();
  initKantoneMenu();
  // Footer's [data-lang-switch] links aren't in the DOM yet when this script
  // runs (Header's markup is parsed and its trailing <script> executes before
  // Footer is parsed), so defer wiring until the full document is ready.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLangSwitcher);
  } else {
    initLangSwitcher();
  }
</script>
