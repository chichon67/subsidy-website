---
// src/components/CantonDirectory.astro
import { deutschschweizCantons } from '../data/deutschschweiz.js';
---

<section id="kantone-grid" class="bg-[#F5F7F8]">
  <div class="max-w-[1240px] mx-auto px-8 py-[52px] md:py-[74px]">
    <h2 class="text-[25px] md:text-[32px] font-bold tracking-tight m-0">Prämienhilfe nach Kanton entdecken</h2>
    <p class="text-[16.5px] leading-[1.7] text-[#3D4A50] mt-[18px] max-w-[44em]">
      Wählen Sie Ihren Kanton und prüfen Sie Ihren Anspruch auf Prämienverbilligung schnell und einfach.
    </p>

    <div class="mt-9 grid grid-cols-2 md:grid-cols-4 gap-4">
      {
        deutschschweizCantons.map((c) => (
          <a
            href={`/${c.slug}`}
            onclick={`if (window.gtag) window.gtag('event', 'canton_directory_selected', { canton: '${c.slug}' })`}
            class="flex items-center gap-3 bg-white border border-[#E2E8EA] rounded-[10px] px-4 py-4 no-underline transition-colors hover:border-teal hover:bg-teal-light"
          >
            <img src={c.wappen} alt={`Wappen ${c.name}`} width="34" height="34" class="flex-shrink-0" loading="lazy" />
            <span class="text-[14.5px] font-semibold text-dark leading-tight">{c.name}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
