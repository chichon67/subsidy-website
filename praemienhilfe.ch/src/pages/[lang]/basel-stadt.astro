---
// src/pages/[lang]/basel-stadt.astro
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import TrustBar from '../../components/TrustBar.astro';
import InfoSection from '../../components/InfoSection.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import ProblemSection from '../../components/ProblemSection.astro';
import WerWirSindSection from '../../components/WerWirSindSection.astro';
import FAQ from '../../components/FAQ.astro';
import SituationFinalCTA from '../../components/SituationFinalCTA.astro';
import { LOCALES } from '../../i18n/locales.js';
import { canonicalFor } from '../../i18n/pageUrls.js';
import { getCanton } from '../../data/cantons.js';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const canton = getCanton('basel-stadt', lang);

const TITLES = {
  de: 'Prämienverbilligung Basel-Stadt | prämienhilfe.ch',
  en: 'Premium reduction Basel-Stadt | prämienhilfe.ch',
  es: 'Reducción de primas Basel-Stadt | prämienhilfe.ch',
};
const DESCRIPTIONS = {
  de: 'Prämienverbilligung im Kanton Basel-Stadt beantragen. EVO Partners GmbH hilft Ihnen kostenlos bei der Einreichung Ihres Antrags. Jetzt Anspruch prüfen — in 20 Minuten.',
  en: 'Apply for the premium reduction in the canton of Basel-Stadt. EVO Partners GmbH helps you file your application for free. Check your entitlement now — in 20 minutes.',
  es: 'Solicite la reducción de primas en el cantón de Basel-Stadt. EVO Partners GmbH le ayuda gratis a presentar su solicitud. Compruebe su derecho ahora — en 20 minutos.',
};
const LOCAL_BUSINESS_DESC = {
  de: 'Unabhängige Beratung bei der Prämienverbilligung im Kanton Basel-Stadt',
  en: 'Independent advice on the premium reduction in the canton of Basel-Stadt',
  es: 'Asesoramiento independiente sobre la reducción de primas en el cantón de Basel-Stadt',
};

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: 'prämienhilfe.ch – EVO Partners GmbH',
    description: LOCAL_BUSINESS_DESC[lang],
    url: 'https://praemien-hilfe.ch',
    areaServed: { '@type': 'AdministrativeArea', name: 'Basel-Stadt' },
    serviceType: 'Prämienverbilligung Beratung',
    provider: {
      '@type': 'Organization',
      name: 'EVO Partners GmbH',
      description: 'FINMA-registrierter Versicherungsbroker',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: canton.faqs.slice(0, 2).map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<Base
  title={TITLES[lang]}
  description={DESCRIPTIONS[lang]}
  canonical={canonicalFor('basel-stadt', lang, Astro.url.pathname)}
  activePage="basel-stadt"
  cantonName="Basel-Stadt"
  lang={lang}
  pageKey="basel-stadt"
  schema={schema}
>
  <Hero canton={canton} defaultCanton="Basel-Stadt" embeddedFunnel={true} lang={lang} />
  <TrustBar canton={canton} />
  <InfoSection canton={canton} />
  <HowItWorks steps={canton.steps} id="so-funktioniert-es" lang={lang} />
  <ProblemSection lang={lang} />
  <WerWirSindSection lang={lang} />
  <FAQ canton={canton} lang={lang} />
  <SituationFinalCTA lang={lang} />
</Base>
