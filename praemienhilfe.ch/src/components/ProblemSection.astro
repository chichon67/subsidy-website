---
// src/components/ProblemSection.astro
import { getDictionary, t } from '../i18n/index.js';

export interface Props {
  lang: string;
  heading?: string;
  intro?: string;
  reasons?: { title: string; text: string }[];
  closing?: string;
}
const { lang, heading, intro, reasons, closing } = Astro.props;
const dict = getDictionary(lang);
const resolvedHeading = heading ?? t(dict, 'problemSection.heading');
const resolvedIntro = intro ?? t(dict, 'problemSection.intro');
const resolvedReasons = reasons ?? dict.problemSection.reasons;
---

<section class="bg-white">
  <div class="max-w-[1240px] mx-auto px-8 py-[52px] md:py-[74px]">
    <h2 class="text-[25px] md:text-[32px] font-bold tracking-tight m-0 max-w-[26em] leading-tight">{resolvedHeading}</h2>
    <p class="text-[16.5px] leading-[1.7] text-[#3D4A50] mt-[22px] max-w-[44em]">{resolvedIntro}</p>
    <div class="mt-7 grid gap-3.5 max-w-[44em]">
      {
        resolvedReasons.map((r) => (
          <div class="flex items-baseline gap-3.5 text-base leading-relaxed">
            <span class="w-2 h-2 rounded-full bg-swiss-red flex-shrink-0 -translate-y-px" />
            <span>
              <strong class="font-bold">{r.title}</strong> — <span class="text-[#3D4A50]">{r.text}</span>
            </span>
          </div>
        ))
      }
    </div>
    {closing && <p class="text-[16.5px] leading-[1.7] text-[#3D4A50] mt-7 max-w-[44em]">{closing}</p>}
  </div>
</section>
